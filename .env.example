# Copy this file to .env.local and fill in the values you have.
# The app runs fully without any AI key — it falls back to deterministic
# parsing for XLSX/table/date extraction and flags everything else for
# manual review.

# SQLite database location (relative to project root works fine locally).
DATABASE_URL="file:./data/study-planner.db"

# --- AI extraction (optional) ---------------------------------------------
# Choose ONE provider. If AI_PROVIDER is unset or the matching key is
# missing, intelligent document extraction is disabled and the app tells
# you so in the Review Import screen, but everything else still works.

# "anthropic" | "openai" | "none"
AI_PROVIDER="anthropic"

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com/) — only used if AI_PROVIDER=openai
OPENAI_API_KEY=
